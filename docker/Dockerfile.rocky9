# ═══════════════════════════════════════════════════════════════════════════════
# OpenDCC  —  Rocky Linux 9 / VFX Platform 2023 multi-stage Docker build
#
# Build context:  ShapeFX/   (parent of OpenDCC/ AND usd-viewer/)
# Build with:     docker-compose -f OpenDCC/docker/docker-compose.yml build rocky9
#              or docker build -f OpenDCC/docker/Dockerfile.rocky9 \
#                              -t opendcc:rocky9 \
#                              ../..
#
# Stages
#   base           – Rocky 9 with system + VFX deps (Qt 5.15, Boost, TBB, etc.)
#   builder        – builds all third-party C++ deps (ADS, sentry, OpenMesh, etc.)
#   usd_build      – compiles OpenUSD 23.05 from source
#   opendcc_build  – compiles OpenDCC with CMake/Ninja
#   runtime        – minimal image: compiled binaries + web server + usd-wasm
#
# VFX Reference Platform 2023 targets:
#   GCC 11.x, Python 3.10, Qt 5.15, Boost 1.80, TBB 2020.3,
#   OpenEXR 3.1, OCIO 2.1, OIIO 2.4, OpenSubdiv 3.5, USD 23.05
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# Stage 0 – Rocky 9 base with development tools
# ─────────────────────────────────────────────────────────────────────────────
FROM rockylinux:9 AS base

# Enable EPEL + CRB (CodeReady Builder) for extra dev packages
RUN dnf install -y epel-release && \
    dnf config-manager --set-enabled crb && \
    dnf update -y && \
    dnf groupinstall -y "Development Tools" && \
    dnf install -y --allowerasing \
        cmake \
        ninja-build \
        gcc-toolset-12-gcc \
        gcc-toolset-12-gcc-c++ \
        python3.11 \
        python3.11-devel \
        python3.11-pip \
        # Core VFX / build deps
        boost-devel \
        tbb-devel \
        glew-devel \
        mesa-libGL-devel \
        mesa-libGLU-devel \
        libXrandr-devel \
        libXinerama-devel \
        libXcursor-devel \
        libXi-devel \
        libXext-devel \
        libXrender-devel \
        libXfixes-devel \
        libXcomposite-devel \
        libXdamage-devel \
        libxkbcommon-devel \
        libxkbcommon-x11-devel \
        wayland-devel \
        xcb-util-devel \
        xcb-util-wm-devel \
        xcb-util-image-devel \
        xcb-util-keysyms-devel \
        xcb-util-renderutil-devel \
        fontconfig-devel \
        freetype-devel \
        # Image / color libs
        openexr-devel \
        imath-devel \
        # Networking / IPC
        zeromq-devel \
        cppzmq-devel \
        # Math / physics
        eigen3-devel \
        bullet-devel \
        # Graphviz (node editor)
        graphviz-devel \
        # Misc
        git \
        curl \
        wget \
        bzip2 \
        xz \
        patch \
        which \
        nasm \
        autoconf \
        automake \
        libtool \
        pkgconfig \
        openssl-devel \
        zlib-devel \
        # Multimedia / Qt deps
        alsa-lib-devel \
        pulseaudio-libs-devel \
        libsndfile-devel \
    && dnf clean all

# Use GCC 12 from gcc-toolset-12 by default
ENV PATH="/opt/rh/gcc-toolset-12/root/usr/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-12/root/usr/lib64:${LD_LIBRARY_PATH}"
ENV CC=/opt/rh/gcc-toolset-12/root/usr/bin/gcc
ENV CXX=/opt/rh/gcc-toolset-12/root/usr/bin/g++

# Make python3.11 the default python3
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    alternatives --set python3 /usr/bin/python3.11 && \
    python3 -m pip install --upgrade pip setuptools wheel

# Symlink for CMake to find Python
RUN ln -sf /usr/bin/python3.11 /usr/local/bin/python3


# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 – Third-party dependency builder
# ─────────────────────────────────────────────────────────────────────────────
FROM base AS builder

# ── Qt 5.15 from source ──────────────────────────────────────────────────────
# Rocky 9 ships Qt 5.15 but may lack some modules; build from source for
# full control and VFX Platform compliance.
ARG QT_VERSION=5.15.12
ARG QT_MAJOR_MINOR=5.15
RUN cd /tmp && \
    curl -fsSL "https://download.qt.io/archive/qt/${QT_MAJOR_MINOR}/${QT_VERSION}/single/qt-everywhere-opensource-src-${QT_VERSION}.tar.xz" \
        -o qt-src.tar.xz && \
    tar -xf qt-src.tar.xz && \
    cd qt-everywhere-src-${QT_VERSION} && \
    ./configure \
        -prefix /opt/qt5 \
        -opensource -confirm-license \
        -release \
        -shared \
        -nomake examples \
        -nomake tests \
        -skip qt3d -skip qtandroidextras -skip qtcharts -skip qtdatavis3d \
        -skip qtdoc -skip qtgamepad -skip qtlottie -skip qtpurchasing \
        -skip qtquick3d -skip qtquicktimeline -skip qtremoteobjects \
        -skip qtsensors -skip qtserialbus -skip qtserialport \
        -skip qtvirtualkeyboard -skip qtwayland -skip qtwebchannel \
        -skip qtwebengine -skip qtwebglplugin -skip qtwebsockets \
        -skip qtwebview -skip qtwinextras \
        -xcb \
        -opengl desktop \
        -system-freetype \
        -fontconfig \
        -system-zlib \
        -system-libpng \
        -system-libjpeg && \
    make -j$(nproc) && \
    make install && \
    rm -rf /tmp/qt-*
ENV PATH="/opt/qt5/bin:${PATH}"
ENV CMAKE_PREFIX_PATH="/opt/qt5:${CMAKE_PREFIX_PATH}"

# ── PySide2 + Shiboken2 ──────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir PySide2 shiboken2 || \
    echo "⚠  PySide2 wheel unavailable — will build from source if needed"

# ── Boost.Python (ensure boost_python links to Python 3.11) ──────────────────
# Rocky 9 boost-devel may link to system python3.9; rebuild boost_python
ARG BOOST_VERSION=1.80.0
ARG BOOST_VERSION_US=1_80_0
RUN cd /tmp && \
    curl -fsSL "https://boostorg.jfrog.io/artifactory/main/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION_US}.tar.bz2" \
        -o boost.tar.bz2 && \
    tar -xf boost.tar.bz2 && \
    cd boost_${BOOST_VERSION_US} && \
    echo "using python : 3.11 : /usr/bin/python3.11 : /usr/include/python3.11 : /usr/lib64 ;" > user-config.jam && \
    ./bootstrap.sh --with-python=python3.11 --prefix=/opt/boost && \
    ./b2 --user-config=user-config.jam \
         --with-python --with-filesystem --with-system --with-thread \
         --with-program_options --with-regex --with-date_time \
         --with-serialization --with-iostreams --with-atomic \
         variant=release link=shared threading=multi \
         install --prefix=/opt/boost -j$(nproc) && \
    rm -rf /tmp/boost*
ENV BOOST_ROOT=/opt/boost
ENV LD_LIBRARY_PATH="/opt/boost/lib:${LD_LIBRARY_PATH}"

# ── OpenColorIO 2.2 ──────────────────────────────────────────────────────────
ARG OCIO_VERSION=v2.2.1
RUN git clone --depth 1 --branch ${OCIO_VERSION} \
        https://github.com/AcademySoftwareFoundation/OpenColorIO.git /tmp/ocio && \
    cmake -S /tmp/ocio -B /tmp/ocio/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/ocio \
        -DOCIO_BUILD_APPS=OFF \
        -DOCIO_BUILD_TESTS=OFF \
        -DOCIO_BUILD_GPU_TESTS=OFF \
        -DOCIO_BUILD_PYTHON=OFF && \
    ninja -C /tmp/ocio/build -j$(nproc) install && \
    rm -rf /tmp/ocio

# ── OpenImageIO 2.4 ──────────────────────────────────────────────────────────
ARG OIIO_VERSION=v2.4.17.0
RUN git clone --depth 1 --branch ${OIIO_VERSION} \
        https://github.com/AcademySoftwareFoundation/OpenImageIO.git /tmp/oiio && \
    cmake -S /tmp/oiio -B /tmp/oiio/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/oiio \
        -DCMAKE_PREFIX_PATH="/opt/ocio" \
        -DOIIO_BUILD_TESTS=OFF \
        -DOIIO_BUILD_TOOLS=OFF \
        -DUSE_PYTHON=OFF \
        -DUSE_QT=OFF && \
    ninja -C /tmp/oiio/build -j$(nproc) install && \
    rm -rf /tmp/oiio

# ── OpenSubdiv 3.5 ───────────────────────────────────────────────────────────
ARG OSD_VERSION=v3_5_0
RUN git clone --depth 1 --branch ${OSD_VERSION} \
        https://github.com/PixarAnimationStudios/OpenSubdiv.git /tmp/osd && \
    cmake -S /tmp/osd -B /tmp/osd/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/osd \
        -DNO_TUTORIALS=ON \
        -DNO_EXAMPLES=ON \
        -DNO_REGRESSION=ON \
        -DNO_DOC=ON \
        -DNO_OMP=ON \
        -DNO_CUDA=ON \
        -DNO_OPENCL=ON \
        -DNO_PTEX=ON && \
    ninja -C /tmp/osd/build -j$(nproc) install && \
    rm -rf /tmp/osd

# ── Embree 3 ──────────────────────────────────────────────────────────────────
ARG EMBREE_VERSION=v3.13.5
RUN git clone --depth 1 --branch ${EMBREE_VERSION} \
        https://github.com/embree/embree.git /tmp/embree && \
    cmake -S /tmp/embree -B /tmp/embree/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/embree \
        -DEMBREE_TUTORIALS=OFF \
        -DEMBREE_ISPC_SUPPORT=OFF && \
    ninja -C /tmp/embree/build -j$(nproc) install && \
    rm -rf /tmp/embree

# ── doctest (header-only) ─────────────────────────────────────────────────────
ARG DOCTEST_VERSION=2.4.11
RUN git clone --depth 1 --branch v${DOCTEST_VERSION} \
        https://github.com/doctest/doctest.git /tmp/doctest && \
    cmake -S /tmp/doctest -B /tmp/doctest/build \
        -DDOCTEST_WITH_TESTS=OFF \
        -DCMAKE_INSTALL_PREFIX=/opt/deps && \
    cmake --build /tmp/doctest/build --target install && \
    rm -rf /tmp/doctest

# ── Qt Advanced Docking System ────────────────────────────────────────────────
ARG ADS_VERSION=3.8.2
RUN git clone --depth 1 --branch ${ADS_VERSION} \
        https://github.com/githubuser0xFFFF/Qt-Advanced-Docking-System.git /tmp/ads && \
    cmake -S /tmp/ads -B /tmp/ads/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="/opt/qt5" \
        -DCMAKE_INSTALL_PREFIX=/opt/deps \
        -DBUILD_EXAMPLES=OFF && \
    ninja -C /tmp/ads/build -j$(nproc) install && \
    rm -rf /tmp/ads

# ── Sentry-native ─────────────────────────────────────────────────────────────
ARG SENTRY_VERSION=0.6.6
RUN git clone --depth 1 --branch ${SENTRY_VERSION} --recurse-submodules \
        https://github.com/getsentry/sentry-native.git /tmp/sentry && \
    cmake -S /tmp/sentry -B /tmp/sentry/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DSENTRY_BACKEND=inproc \
        -DSENTRY_BUILD_TESTS=OFF \
        -DSENTRY_BUILD_EXAMPLES=OFF \
        -DCMAKE_INSTALL_PREFIX=/opt/deps && \
    ninja -C /tmp/sentry/build -j$(nproc) install && \
    rm -rf /tmp/sentry

# ── OpenMesh ──────────────────────────────────────────────────────────────────
ARG OPENMESH_VERSION=9.0
RUN curl -fsSL "https://www.graphics.rwth-aachen.de/media/openmesh_static/Releases/${OPENMESH_VERSION}/OpenMesh-${OPENMESH_VERSION}.tar.bz2" \
        | tar -xj -C /tmp && \
    cmake -S /tmp/OpenMesh-${OPENMESH_VERSION}.0 -B /tmp/openmesh_build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_APPS=OFF \
        -DCMAKE_INSTALL_PREFIX=/opt/deps && \
    ninja -C /tmp/openmesh_build -j$(nproc) install && \
    rm -rf /tmp/OpenMesh-${OPENMESH_VERSION}.0 /tmp/openmesh_build

# ── libigl (header-only) ──────────────────────────────────────────────────────
RUN git clone --depth 1 https://github.com/libigl/libigl.git /opt/deps/include/igl_src && \
    ln -s /opt/deps/include/igl_src/include/igl /opt/deps/include/igl

# ── OSL (Open Shading Language) ──────────────────────────────────────────────
# Build a minimal OSL for OpenDCC (shader compiler + runtime)
ARG OSL_VERSION=v1.12.14.0
RUN git clone --depth 1 --branch ${OSL_VERSION} \
        https://github.com/AcademySoftwareFoundation/OpenShadingLanguage.git /tmp/osl && \
    cmake -S /tmp/osl -B /tmp/osl/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/osl \
        -DCMAKE_PREFIX_PATH="/opt/oiio;/opt/ocio;/opt/boost" \
        -DOSL_BUILD_TESTS=OFF \
        -DOSL_BUILD_PLUGINS=OFF \
        -DUSE_QT=OFF && \
    ninja -C /tmp/osl/build -j$(nproc) install && \
    rm -rf /tmp/osl

# ── Alembic ───────────────────────────────────────────────────────────────────
ARG ALEMBIC_VERSION=1.8.5
RUN git clone --depth 1 --branch ${ALEMBIC_VERSION} \
        https://github.com/alembic/alembic.git /tmp/alembic && \
    cmake -S /tmp/alembic -B /tmp/alembic/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/deps \
        -DUSE_TESTS=OFF \
        -DUSE_BINARIES=OFF \
        -DUSE_HDF5=OFF && \
    ninja -C /tmp/alembic/build -j$(nproc) install && \
    rm -rf /tmp/alembic

# ── MaterialX ────────────────────────────────────────────────────────────────
ARG MATERIALX_VERSION=v1.38.8
RUN git clone --depth 1 --branch ${MATERIALX_VERSION} \
        https://github.com/AcademySoftwareFoundation/MaterialX.git /tmp/materialx && \
    cmake -S /tmp/materialx -B /tmp/materialx/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/deps \
        -DMATERIALX_BUILD_TESTS=OFF \
        -DMATERIALX_BUILD_PYTHON=OFF \
        -DMATERIALX_BUILD_VIEWER=OFF \
        -DMATERIALX_BUILD_RENDER=ON \
        -DMATERIALX_BUILD_GEN_GLSL=ON \
        -DMATERIALX_BUILD_GEN_OSL=ON && \
    ninja -C /tmp/materialx/build -j$(nproc) install && \
    rm -rf /tmp/materialx

# ── pybind11 ──────────────────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir pybind11

# ── Python web dependencies ───────────────────────────────────────────────────
COPY OpenDCC/web/requirements_web.txt /tmp/requirements_web.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements_web.txt


# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 – OpenUSD 23.05 build
# ─────────────────────────────────────────────────────────────────────────────
FROM builder AS usd_build

ARG USD_VERSION=v23.05
RUN git clone --depth 1 --branch ${USD_VERSION} \
        https://github.com/PixarAnimationStudios/OpenUSD.git /tmp/usd_src && \
    cmake -S /tmp/usd_src -B /tmp/usd_build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/usd \
        -DCMAKE_PREFIX_PATH="/opt/boost;/opt/ocio;/opt/oiio;/opt/osd;/opt/embree;/opt/qt5;/opt/deps" \
        -DPXR_BUILD_TESTS=OFF \
        -DPXR_BUILD_EXAMPLES=OFF \
        -DPXR_BUILD_TUTORIALS=OFF \
        -DPXR_BUILD_USD_TOOLS=ON \
        -DPXR_BUILD_IMAGING=ON \
        -DPXR_BUILD_USD_IMAGING=ON \
        -DPXR_BUILD_USDVIEW=OFF \
        -DPXR_ENABLE_PYTHON_SUPPORT=ON \
        -DPXR_USE_PYTHON_3=ON \
        -DPython3_EXECUTABLE=/usr/bin/python3.11 \
        -DPXR_BUILD_ALEMBIC_PLUGIN=ON \
        -DPXR_ENABLE_MATERIALX_SUPPORT=ON && \
    ninja -C /tmp/usd_build -j$(nproc) install && \
    rm -rf /tmp/usd_src /tmp/usd_build /opt/usd/src /opt/usd/build


# ─────────────────────────────────────────────────────────────────────────────
# Stage 3 – OpenDCC build
# ─────────────────────────────────────────────────────────────────────────────
FROM usd_build AS opendcc_build

WORKDIR /src
COPY OpenDCC/ /src/OpenDCC

RUN cmake -S /src/OpenDCC -B /src/build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/opendcc \
    -DUSD_ROOT=/opt/usd \
    -DCMAKE_PREFIX_PATH="/opt/qt5;/opt/boost;/opt/deps;/opt/usd;/opt/ocio;/opt/oiio;/opt/osd;/opt/embree;/opt/osl" \
    -DPython3_ROOT_DIR=/usr \
    -DPython3_EXECUTABLE=/usr/bin/python3.11 \
    -DDCC_PYSIDE_CMAKE_FIND=OFF \
    -DSHIBOKEN_CLANG_INSTALL_DIR=/usr \
    -Dqtadvanceddocking_DIR=/opt/deps/lib/cmake/qtadvanceddocking \
    -Dsentry_DIR=/opt/deps/lib/cmake/sentry \
    -Ddoctest_DIR=/opt/deps/lib/cmake/doctest \
    -DOpenMesh_DIR=/opt/deps/share/OpenMesh/cmake \
    -DDCC_BUILD_ARNOLD_SUPPORT=OFF \
    -DDCC_USD_FALLBACK_PROXY_BUILD_ARNOLD_USD=OFF \
    -DDCC_USD_FALLBACK_PROXY_BUILD_CYCLES=OFF \
    -DDCC_BUILD_RENDERMAN_SUPPORT=OFF \
    -DDCC_EMBEDDED_PYTHON_HOME=ON \
    -DDCC_BUILD_RENDER_VIEW=ON \
    -DDCC_BUILD_TESTS=OFF && \
    ninja -C /src/build -j$(nproc) install


# ─────────────────────────────────────────────────────────────────────────────
# Stage 4 – runtime image (minimal Rocky 9)
# ─────────────────────────────────────────────────────────────────────────────
FROM rockylinux:9 AS runtime

# Enable EPEL for runtime deps
RUN dnf install -y epel-release && \
    dnf config-manager --set-enabled crb && \
    dnf install -y --allowerasing \
        python3.11 \
        python3.11-pip \
        # Shared libs needed at runtime
        boost-system \
        boost-filesystem \
        boost-thread \
        boost-program-options \
        boost-regex \
        boost-date-time \
        boost-serialization \
        boost-iostreams \
        boost-atomic \
        tbb \
        glew \
        mesa-libGL \
        mesa-libGLU \
        mesa-dri-drivers \
        libXrandr \
        libXinerama \
        libXcursor \
        libXi \
        libxkbcommon \
        libxkbcommon-x11 \
        fontconfig \
        freetype \
        zeromq \
        graphviz \
        openexr-libs \
        imath \
        eigen3 \
        alsa-lib \
        curl \
    && dnf clean all

# Make python3.11 the default
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    alternatives --set python3 /usr/bin/python3.11

# ── Copy compiled artifacts ───────────────────────────────────────────────────
COPY --from=opendcc_build /opt/opendcc /opt/opendcc
COPY --from=opendcc_build /opt/deps    /opt/deps
COPY --from=opendcc_build /opt/usd     /opt/usd
COPY --from=opendcc_build /opt/qt5     /opt/qt5
COPY --from=opendcc_build /opt/boost   /opt/boost
COPY --from=opendcc_build /opt/ocio    /opt/ocio
COPY --from=opendcc_build /opt/oiio    /opt/oiio
COPY --from=opendcc_build /opt/osd     /opt/osd
COPY --from=opendcc_build /opt/embree  /opt/embree
COPY --from=opendcc_build /opt/osl     /opt/osl

# ── Web server sources ────────────────────────────────────────────────────────
COPY OpenDCC/web/ /opt/opendcc/web/

# ── usd-wasm (optional — run docker/build.sh to create stubs if missing) ─────
COPY usd-viewer/usd-wasm/src     /opt/usd-viewer/usd-wasm/src
COPY usd-viewer/public/modules   /opt/usd-viewer/public/modules

# ── Runtime Python packages ───────────────────────────────────────────────────
COPY OpenDCC/web/requirements_web.txt /tmp/requirements_web.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements_web.txt

# ── Environment ──────────────────────────────────────────────────────────────
ENV PYTHONPATH="/opt/opendcc/lib/python3.11/site-packages:/opt/usd/lib/python:/opt/boost/lib/python3.11/site-packages"
ENV LD_LIBRARY_PATH="/opt/opendcc/lib:/opt/deps/lib:/opt/usd/lib:/opt/qt5/lib:/opt/boost/lib:/opt/ocio/lib:/opt/oiio/lib:/opt/osd/lib:/opt/embree/lib:/opt/osl/lib"
ENV PXR_PLUGINPATH_NAME="/opt/opendcc/plugin/usd:/opt/opendcc/plugin/opendcc:/opt/usd/lib/usd"
ENV OPENDCC_ROOT=/opt/opendcc
ENV USD_VIEWER_PATH=/opt/usd-viewer
ENV PATH="/opt/qt5/bin:/opt/usd/bin:${PATH}"

# Headless Qt (no display required for web server)
ENV QT_QPA_PLATFORM=offscreen
ENV DISPLAY=

WORKDIR /opt/opendcc
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["python3", "/opt/opendcc/web/server.py", "--host", "0.0.0.0", "--port", "8080"]
