# ═══════════════════════════════════════════════════════════════════════════════
# OpenDCC  —  Rocky Linux 9 headless server build (NO Qt)
#
# Full USD pipeline compiled from source with all VFX deps:
#   Hydra, Alembic, MaterialX, OCIO, OIIO, OpenSubdiv, Embree, OSL
#
# Qt is NOT built — the UI runs entirely in the browser.
# This saves ~1-2 hours of build time vs the desktop variant.
#
# Build context:  ShapeFX/   (parent of OpenDCC/)
# Build with:     cd OpenDCC/docker && bash build.sh rocky9
#              or docker build -f OpenDCC/docker/Dockerfile.rocky9 \
#                              -t opendcc:rocky9 ../..
#
# Stages
#   base           – Rocky 9 with all -devel packages (no Qt)
#   builder        – builds all third-party C++ VFX deps from source
#   usd_build      – compiles OpenUSD 23.05 with full imaging pipeline
#   runtime        – minimal image: USD + VFX libs + web server
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# Stage 0 – Rocky 9 base with ALL development packages
# ─────────────────────────────────────────────────────────────────────────────
FROM rockylinux:9 AS base

RUN dnf install -y epel-release && \
    dnf config-manager --set-enabled crb && \
    dnf update -y && \
    dnf groupinstall -y "Development Tools" && \
    dnf install -y --allowerasing \
        # ── Compiler ──────────────────────────────────────────────────────
        cmake \
        ninja-build \
        gcc-toolset-12-gcc \
        gcc-toolset-12-gcc-c++ \
        # ── Python ────────────────────────────────────────────────────────
        python3.11 \
        python3.11-devel \
        python3.11-pip \
        # ── VFX core libs ─────────────────────────────────────────────────
        boost-devel \
        tbb-devel \
        glew-devel \
        openexr-devel \
        imath-devel \
        eigen3-devel \
        # ── GL / X11 (headless rendering via EGL/OSMesa) ──────────────────
        mesa-libGL-devel \
        mesa-libGLU-devel \
        mesa-libEGL-devel \
        mesa-libOSMesa-devel \
        libX11-devel \
        libXrandr-devel \
        libXinerama-devel \
        libXcursor-devel \
        libXi-devel \
        libXext-devel \
        libXrender-devel \
        libXfixes-devel \
        libXcomposite-devel \
        libXdamage-devel \
        libXxf86vm-devel \
        # ── Image libs ────────────────────────────────────────────────────
        libjpeg-turbo-devel \
        libpng-devel \
        libtiff-devel \
        libwebp-devel \
        giflib-devel \
        # ── Font / text ───────────────────────────────────────────────────
        fontconfig-devel \
        freetype-devel \
        harfbuzz-devel \
        # ── Networking / IPC ──────────────────────────────────────────────
        zeromq-devel \
        cppzmq-devel \
        openssl-devel \
        # ── Physics ───────────────────────────────────────────────────────
        bullet-devel \
        # ── Graph layout ──────────────────────────────────────────────────
        graphviz-devel \
        # ── LLVM/Clang (needed by OSL) ────────────────────────────────────
        llvm-devel \
        clang-devel \
        clang-libs \
        # ── Compression ───────────────────────────────────────────────────
        zlib-devel \
        bzip2-devel \
        xz-devel \
        libzstd-devel \
        # ── Misc build tools ──────────────────────────────────────────────
        git \
        curl \
        wget \
        bzip2 \
        xz \
        patch \
        which \
        nasm \
        autoconf \
        automake \
        libtool \
        pkgconfig \
        libffi-devel \
        readline-devel \
        sqlite-devel \
    && dnf clean all

# GCC 12
ENV PATH="/opt/rh/gcc-toolset-12/root/usr/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-12/root/usr/lib64:${LD_LIBRARY_PATH}"
ENV CC=/opt/rh/gcc-toolset-12/root/usr/bin/gcc
ENV CXX=/opt/rh/gcc-toolset-12/root/usr/bin/g++

# Python 3.11
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    alternatives --set python3 /usr/bin/python3.11 && \
    python3 -m pip install --upgrade pip setuptools wheel && \
    ln -sf /usr/bin/python3.11 /usr/local/bin/python3


# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 – Third-party VFX dependency builder
# ─────────────────────────────────────────────────────────────────────────────
FROM base AS builder

# ── Boost 1.80 (full build with Python 3.11) ─────────────────────────────────
ARG BOOST_VERSION=1.80.0
ARG BOOST_VERSION_US=1_80_0
RUN cd /tmp && \
    curl -fsSL "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION_US}.tar.gz" \
        -o boost.tar.gz && \
    tar -xzf boost.tar.gz && \
    cd boost_${BOOST_VERSION_US} && \
    echo "using python : 3.11 : /usr/bin/python3.11 : /usr/include/python3.11 : /usr/lib64 ;" > user-config.jam && \
    ./bootstrap.sh --with-python=python3.11 --prefix=/opt/boost && \
    ./b2 --user-config=user-config.jam \
         --with-python --with-filesystem --with-system --with-thread \
         --with-program_options --with-regex --with-date_time \
         --with-serialization --with-iostreams --with-atomic \
         --with-chrono --with-locale --with-log --with-wave \
         --with-random --with-container --with-math \
         --with-type_erasure --with-test \
         variant=release link=shared threading=multi \
         install --prefix=/opt/boost -j$(nproc) && \
    rm -rf /tmp/boost*
ENV BOOST_ROOT=/opt/boost
ENV LD_LIBRARY_PATH="/opt/boost/lib:${LD_LIBRARY_PATH}"

# ── OpenColorIO 2.2 ──────────────────────────────────────────────────────────
ARG OCIO_VERSION=v2.2.1
RUN git clone --depth 1 --branch ${OCIO_VERSION} \
        https://github.com/AcademySoftwareFoundation/OpenColorIO.git /tmp/ocio && \
    cmake -S /tmp/ocio -B /tmp/ocio/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/ocio \
        -DBOOST_ROOT=/opt/boost \
        -DOCIO_BUILD_APPS=OFF \
        -DOCIO_BUILD_TESTS=OFF \
        -DOCIO_BUILD_GPU_TESTS=OFF \
        -DOCIO_BUILD_PYTHON=OFF && \
    ninja -C /tmp/ocio/build -j$(nproc) install && \
    rm -rf /tmp/ocio

# ── OpenImageIO 2.4 ──────────────────────────────────────────────────────────
ARG OIIO_VERSION=v2.4.17.0
RUN git clone --depth 1 --branch ${OIIO_VERSION} \
        https://github.com/AcademySoftwareFoundation/OpenImageIO.git /tmp/oiio && \
    cmake -S /tmp/oiio -B /tmp/oiio/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/oiio \
        -DCMAKE_PREFIX_PATH="/opt/ocio;/opt/boost" \
        -DBOOST_ROOT=/opt/boost \
        -DBoost_NO_SYSTEM_PATHS=ON \
        -DOIIO_BUILD_TESTS=OFF \
        -DOIIO_BUILD_TOOLS=OFF \
        -DUSE_PYTHON=OFF \
        -DUSE_QT=OFF \
        -DUSE_OPENCV=OFF \
        -DUSE_R3DSDK=OFF \
        -DUSE_Nuke=OFF \
        -DUSE_DCMTK=OFF \
        -DUSE_FFmpeg=OFF \
        -DUSE_Field3D=OFF \
        -DUSE_LibRaw=OFF \
        -DUSE_OpenJPEG=OFF \
        -DUSE_OpenVDB=OFF \
        -DUSE_Ptex=OFF && \
    ninja -C /tmp/oiio/build -j$(nproc) install && \
    rm -rf /tmp/oiio

# ── OpenSubdiv 3.5 ───────────────────────────────────────────────────────────
ARG OSD_VERSION=v3_5_0
RUN git clone --depth 1 --branch ${OSD_VERSION} \
        https://github.com/PixarAnimationStudios/OpenSubdiv.git /tmp/osd && \
    cmake -S /tmp/osd -B /tmp/osd/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/osd \
        -DNO_TUTORIALS=ON \
        -DNO_EXAMPLES=ON \
        -DNO_REGRESSION=ON \
        -DNO_DOC=ON \
        -DNO_OMP=ON \
        -DNO_CUDA=ON \
        -DNO_OPENCL=ON \
        -DNO_PTEX=ON \
        -DNO_GLFW=ON \
        -DNO_GLFW_X11=ON && \
    ninja -C /tmp/osd/build -j$(nproc) install && \
    rm -rf /tmp/osd

# ── Embree 3 ──────────────────────────────────────────────────────────────────
ARG EMBREE_VERSION=v3.13.5
RUN git clone --depth 1 --branch ${EMBREE_VERSION} \
        https://github.com/embree/embree.git /tmp/embree && \
    cmake -S /tmp/embree -B /tmp/embree/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/embree \
        -DEMBREE_TUTORIALS=OFF \
        -DEMBREE_ISPC_SUPPORT=OFF \
        -DEMBREE_STATIC_LIB=OFF && \
    ninja -C /tmp/embree/build -j$(nproc) install && \
    rm -rf /tmp/embree

# ── OSL (Open Shading Language) 1.13.x ───────────────────────────────────────
# v1.13.x supports LLVM 13-17 (Rocky 9 ships LLVM 16/17)
ARG OSL_VERSION=v1.13.12.0
RUN git clone --depth 1 --branch ${OSL_VERSION} \
        https://github.com/AcademySoftwareFoundation/OpenShadingLanguage.git /tmp/osl && \
    cmake -S /tmp/osl -B /tmp/osl/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/osl \
        -DCMAKE_PREFIX_PATH="/opt/oiio;/opt/ocio;/opt/boost" \
        -DBOOST_ROOT=/opt/boost \
        -DOSL_BUILD_TESTS=OFF \
        -DOSL_BUILD_PLUGINS=OFF \
        -DOSL_BUILD_MATERIALX=OFF \
        -DUSE_QT=OFF \
        -DUSE_PYTHON=OFF && \
    ninja -C /tmp/osl/build -j$(nproc) install && \
    rm -rf /tmp/osl

# ── Alembic 1.8.6 ────────────────────────────────────────────────────────────
ARG ALEMBIC_VERSION=1.8.6
RUN git clone --depth 1 --branch ${ALEMBIC_VERSION} \
        https://github.com/alembic/alembic.git /tmp/alembic && \
    cmake -S /tmp/alembic -B /tmp/alembic/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/deps \
        -DBOOST_ROOT=/opt/boost \
        -DUSE_TESTS=OFF \
        -DUSE_BINARIES=OFF \
        -DUSE_HDF5=OFF && \
    ninja -C /tmp/alembic/build -j$(nproc) install && \
    rm -rf /tmp/alembic

# ── MaterialX 1.38.8 ─────────────────────────────────────────────────────────
ARG MATERIALX_VERSION=v1.38.8
RUN git clone --depth 1 --branch ${MATERIALX_VERSION} \
        https://github.com/AcademySoftwareFoundation/MaterialX.git /tmp/materialx && \
    cmake -S /tmp/materialx -B /tmp/materialx/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/deps \
        -DMATERIALX_BUILD_TESTS=OFF \
        -DMATERIALX_BUILD_PYTHON=OFF \
        -DMATERIALX_BUILD_VIEWER=OFF \
        -DMATERIALX_BUILD_RENDER=ON \
        -DMATERIALX_BUILD_GEN_GLSL=ON \
        -DMATERIALX_BUILD_GEN_OSL=ON && \
    ninja -C /tmp/materialx/build -j$(nproc) install && \
    rm -rf /tmp/materialx

# ── pybind11 ──────────────────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir pybind11

# ── Python web dependencies ───────────────────────────────────────────────────
COPY OpenDCC/web/requirements_web.txt /tmp/requirements_web.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements_web.txt


# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 – OpenUSD 23.05 (full pipeline, NO Qt)
#
# Everything enabled:
#   Imaging, UsdImaging, Hydra, Python, Alembic, MaterialX,
#   OCIO, OIIO, OpenSubdiv, Embree
#
# NOT built: usdview (needs Qt), Qt bindings
# ─────────────────────────────────────────────────────────────────────────────
FROM builder AS usd_build

ARG USD_VERSION=v23.05
RUN git clone --depth 1 --branch ${USD_VERSION} \
        https://github.com/PixarAnimationStudios/OpenUSD.git /tmp/usd_src && \
    cmake -S /tmp/usd_src -B /tmp/usd_build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/usd \
        -DCMAKE_PREFIX_PATH="/opt/boost;/opt/ocio;/opt/oiio;/opt/osd;/opt/embree;/opt/osl;/opt/deps" \
        -DBOOST_ROOT=/opt/boost \
        -DBoost_NO_SYSTEM_PATHS=ON \
        # ── Core ──────────────────────────────────────────────────────────
        -DPXR_BUILD_TESTS=OFF \
        -DPXR_BUILD_EXAMPLES=OFF \
        -DPXR_BUILD_TUTORIALS=OFF \
        -DPXR_BUILD_USD_TOOLS=ON \
        # ── Imaging / Hydra ───────────────────────────────────────────────
        -DPXR_BUILD_IMAGING=ON \
        -DPXR_BUILD_USD_IMAGING=ON \
        -DPXR_ENABLE_GL_SUPPORT=ON \
        # ── Python (full bindings) ────────────────────────────────────────
        -DPXR_ENABLE_PYTHON_SUPPORT=ON \
        -DPXR_USE_PYTHON_3=ON \
        -DPython3_EXECUTABLE=/usr/bin/python3.11 \
        # ── Plugins ───────────────────────────────────────────────────────
        -DPXR_BUILD_ALEMBIC_PLUGIN=ON \
        -DPXR_ENABLE_MATERIALX_SUPPORT=ON \
        # ── No Qt (UI is in the browser) ──────────────────────────────────
        -DPXR_BUILD_USDVIEW=OFF \
        -DPXR_ENABLE_QT_SUPPORT=OFF && \
    ninja -C /tmp/usd_build -j$(nproc) install && \
    rm -rf /tmp/usd_src /tmp/usd_build


# ─────────────────────────────────────────────────────────────────────────────
# Stage 3 – runtime image (minimal Rocky 9)
# ─────────────────────────────────────────────────────────────────────────────
FROM rockylinux:9 AS runtime

RUN dnf install -y epel-release && \
    dnf config-manager --set-enabled crb && \
    dnf install -y --allowerasing \
        python3.11 \
        python3.11-pip \
        # Runtime shared libs
        boost-system \
        boost-filesystem \
        boost-thread \
        boost-program-options \
        boost-regex \
        boost-date-time \
        boost-serialization \
        boost-iostreams \
        boost-atomic \
        boost-chrono \
        boost-locale \
        tbb \
        glew \
        mesa-libGL \
        mesa-libGLU \
        mesa-libEGL \
        mesa-libOSMesa \
        mesa-dri-drivers \
        libX11 \
        libXrandr \
        libXi \
        libXxf86vm \
        libxkbcommon \
        fontconfig \
        freetype \
        libjpeg-turbo \
        libpng \
        libtiff \
        zeromq \
        graphviz \
        openexr-libs \
        imath \
        llvm-libs \
        alsa-lib \
        curl \
    && dnf clean all

# Python 3.11
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    alternatives --set python3 /usr/bin/python3.11

# ── Copy full VFX pipeline ────────────────────────────────────────────────────
COPY --from=usd_build /opt/usd     /opt/usd
COPY --from=usd_build /opt/boost   /opt/boost
COPY --from=usd_build /opt/ocio    /opt/ocio
COPY --from=usd_build /opt/oiio    /opt/oiio
COPY --from=usd_build /opt/osd     /opt/osd
COPY --from=usd_build /opt/embree  /opt/embree
COPY --from=usd_build /opt/osl     /opt/osl
COPY --from=usd_build /opt/deps    /opt/deps

# ── Web server ────────────────────────────────────────────────────────────────
COPY OpenDCC/web/ /opt/opendcc/web/

# ── usd-wasm (optional — run docker/build.sh to create stubs if missing) ─────
COPY usd-viewer/usd-wasm/src     /opt/usd-viewer/usd-wasm/src
COPY usd-viewer/public/modules   /opt/usd-viewer/public/modules

# ── Runtime Python packages ───────────────────────────────────────────────────
COPY OpenDCC/web/requirements_web.txt /tmp/requirements_web.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements_web.txt

# ── Environment ──────────────────────────────────────────────────────────────
ENV PYTHONPATH="/opt/usd/lib/python:/opt/boost/lib/python3.11/site-packages"
ENV LD_LIBRARY_PATH="/opt/usd/lib:/opt/boost/lib:/opt/ocio/lib:/opt/oiio/lib:/opt/osd/lib:/opt/embree/lib:/opt/osl/lib:/opt/deps/lib"
ENV PXR_PLUGINPATH_NAME="/opt/usd/lib/usd"
ENV USD_VIEWER_PATH=/opt/usd-viewer
ENV OPENDCC_STAGES_ROOT=/data/stages
ENV PATH="/opt/usd/bin:${PATH}"

# Headless rendering
ENV QT_QPA_PLATFORM=offscreen
ENV DISPLAY=

WORKDIR /opt/opendcc
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["python3", "/opt/opendcc/web/server.py", "--host", "0.0.0.0", "--port", "8080"]
